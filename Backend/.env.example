# Production Environment Variables
# Copy this file to .env and fill in actual values
# IMPORTANT: .env is in .gitignore - do not commit secrets!

# For Railway MySQL:
MYSQL_URL=mysql://root:password@eseau.proxy.rlwy.net:41891/railway

# Server configuration
PORT=3000
NODE_ENV=production

# Or use individual database variables (fallback):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=skybooking
